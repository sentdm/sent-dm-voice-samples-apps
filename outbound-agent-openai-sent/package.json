{
  "name": "sent-outbound-agent",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Local Sent VoIP outbound agent with OpenAI Live and Realtime audio",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@11.22.0",
  "scripts": {
    "build": "tsc && node scripts/build.mjs",
    "start": "node dist/server.js",
    "dev": "node scripts/build.mjs && tsx src/server.ts",
    "check": "tsc --noEmit && tsc --noEmit -p tsconfig.client.json",
    "test": "tsx --test tests/*.test.ts",
    "test:browser": "tsx tests/browser-audio.ts",
    "test:dashboard": "tsx tests/browser-dashboard.ts",
    "setup": "pnpm install --frozen-lockfile && pnpm run build"
  },
  "dependencies": {
    "@sentdm/voice": "0.1.1",
    "cloudflared": "0.7.3",
    "express": "5.1.0",
    "ws": "8.22.0"
  },
  "devDependencies": {
    "@types/express": "5.0.3",
    "@types/node": "22.18.6",
    "@types/ws": "8.18.1",
    "esbuild": "0.25.10",
    "playwright": "1.64.0",
    "tsx": "4.20.6",
    "typescript": "5.9.3"
  }
}
