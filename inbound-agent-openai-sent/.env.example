# Optional. Copy to .env (git-ignored) or export these in your shell; shell values win over .env.
# When both keys are set, the server validates them at startup exactly like the dashboard form.
# You can still enter keys in the dashboard, which overrides these for the running session.
SENT_DM_API_KEY=
OPENAI_API_KEY=

# Optional: local dashboard port.
PORT=3000

# Optional: the public tunnel that carries Sent's call questions to this app.
# ngrok is the default. It needs a free account: https://dashboard.ngrok.com/signup
# The app uses NGROK_AUTHTOKEN, or else the token you saved with `ngrok config add-authtoken`.
# Set TUNNEL_PROVIDER=cloudflare for a Cloudflare quick tunnel, which needs no account.
# TUNNEL_PROVIDER=ngrok
# NGROK_AUTHTOKEN=
# Optional: a fixed ngrok domain, for example your free dev domain from https://dashboard.ngrok.com/domains
# NGROK_DOMAIN=
