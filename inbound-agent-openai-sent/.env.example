# Optional. Copy to .env (git-ignored) or export these in your shell; shell values win over .env.
# When both keys are set, the server validates them at startup exactly like the dashboard form.
# You can still enter keys in the dashboard, which overrides these for the running session.
SENT_DM_API_KEY=
OPENAI_API_KEY=

# Optional: local dashboard port.
PORT=3000
