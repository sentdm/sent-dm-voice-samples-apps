# Optional: the app also accepts the keys in its Connect screen.
# They stay in the server's memory and are never written to disk.
SENT_DM_API_KEY=
OPENAI_API_KEY=

# The local port. Defaults to 3000.
# PORT=3000

# Optional: lets your own programs on this computer start campaigns through
# POST /api/campaigns with "Authorization: Bearer <token>". At least 24
# characters, for example the output of: openssl rand -hex 24
# APP_API_TOKEN=

# Optional: the public tunnel that carries Sent's call questions and webhooks to this app.
# ngrok is the default. It needs a free account: https://dashboard.ngrok.com/signup
# The app uses NGROK_AUTHTOKEN, or else the token you saved with `ngrok config add-authtoken`.
# Set TUNNEL_PROVIDER=cloudflare for a Cloudflare quick tunnel, which needs no account.
# TUNNEL_PROVIDER=ngrok
# NGROK_AUTHTOKEN=
# Optional: a fixed ngrok domain, for example your free dev domain from https://dashboard.ngrok.com/domains
# NGROK_DOMAIN=
