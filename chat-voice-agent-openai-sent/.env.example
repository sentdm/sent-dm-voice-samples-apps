# Optional: the app also accepts the keys in its Connect screen.
# They stay in the server's memory and are never written to disk.
SENT_DM_API_KEY=
OPENAI_API_KEY=

# The local port. Defaults to 3000.
# PORT=3000

# Optional: lets your own programs on this computer start campaigns through
# POST /api/campaigns with "Authorization: Bearer <token>". At least 24
# characters, for example the output of: openssl rand -hex 24
# APP_API_TOKEN=
