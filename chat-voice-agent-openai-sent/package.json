{
  "name": "chat-voice-agent-openai-sent",
  "version": "0.1.0",
  "private": true,
  "description": "Chat + voice AI agent console for Sent: one conversation across SMS, WhatsApp, RCS and calls, with people in the loop",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@11.22.0",
  "scripts": {
    "dev": "tsx server/index.ts",
    "build": "next build",
    "start": "tsx server/index.ts --production",
    "check": "next typegen && tsc --noEmit && eslint",
    "test": "tsx --test tests/*.test.ts",
    "lint": "eslint"
  },
  "dependencies": {
    "@ngrok/ngrok": "1.7.0",
    "@sentdm/sentdm": "0.46.0",
    "@sentdm/voice-client": "0.2.1",
    "class-variance-authority": "0.7.1",
    "cloudflared": "0.7.3",
    "cn": "0.4.0",
    "lucide-react": "1.55.0",
    "next": "16.4.3",
    "radix-ui": "1.7.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "shadcn": "4.21.4",
    "sonner": "2.0.8",
    "tsx": "4.20.6",
    "tw-animate-css": "1.4.0",
    "ws": "8.22.0"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "22.18.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/ws": "8.18.1",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.3",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3"
  }
}
