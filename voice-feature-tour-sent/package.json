{
  "name": "voice-feature-tour-sent",
  "version": "0.1.0",
  "private": true,
  "description": "Sent voice feature tour: a browser phone on @sentdm/voice-client and the backend that mints voice tokens, answers call questions and receives call webhooks",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.27.0",
  "scripts": {
    "dev": "node scripts/copy-service-worker.mjs && next dev",
    "build": "node scripts/copy-service-worker.mjs && next build",
    "start": "next start",
    "check": "next typegen && tsc --noEmit && eslint .",
    "lint": "eslint .",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@ngrok/ngrok": "1.7.0",
    "@sentdm/voice-client": "^0.2.0",
    "@sentdm/voice-client-react": "^0.2.0",
    "class-variance-authority": "^0.7.1",
    "cloudflared": "0.7.3",
    "cn": "^0.3.2",
    "lucide-react": "^1.31.0",
    "next": "16.3.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "shadcn": "^4.21.0",
    "sonner": "^2.0.8",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.2.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "eslint": "^9.39.3",
    "eslint-config-next": "16.3.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "postcss": "^8.5.26",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3"
  }
}
