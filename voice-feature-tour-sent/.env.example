# Everything the app needs is entered on the setup screen and saved to .data/config.json.
# These variables are optional.

# Folder for the saved configuration. Defaults to ./.data
# DATA_DIR=./.data

# Sent only calls public URLs, so the app opens a tunnel to itself when it starts. ngrok is the
# default. It needs a free account (https://dashboard.ngrok.com/signup). The app uses
# NGROK_AUTHTOKEN, or else the token you saved with `ngrok config add-authtoken`.
# TUNNEL_PROVIDER=ngrok
# NGROK_AUTHTOKEN=

# Optional: a fixed ngrok domain, for example your free dev domain from
# https://dashboard.ngrok.com/domains. The public URL then stays the same on every start.
# NGROK_DOMAIN=your-name.ngrok-free.app

# Set TUNNEL_PROVIDER=cloudflare for a Cloudflare quick tunnel instead. It needs no account, and
# gets a new public URL on every start.

# To use a public HTTPS URL of your own, set it here. The app then opens no tunnel.
# PUBLIC_BASE_URL=https://your-tunnel.example

# Extra hostnames allowed to open the dev server through your own tunnel, comma separated.
# The usual ngrok and Cloudflare tunnel domains are allowed already.
# DEV_ORIGINS=voice.example.com

# When set, the setup screen, the routing rules and the webhook subscription need this password.
# Off by default: the app is a prototype meant to run behind a private tunnel URL.
# SETUP_PASSWORD=change-me
